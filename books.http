### Variables globales
@baseUrl = http://localhost:3000/api/books

###############################################################################
# REQ-02 · Listado de libros (GET /api/books)
###############################################################################

### 2.1 GET /api/books (Caso Exitoso - Devuelve la lista con los 2 libros iniciales)
GET {{baseUrl}}
Content-Type: application/json


###############################################################################
# REQ-03 · Consulta individual (GET /api/books/:id)
###############################################################################

### 3.1 GET /api/books/1 (Caso Exitoso - Devuelve "Clean Code")
GET {{baseUrl}}/1
Content-Type: application/json

### 3.2 GET /api/books/999 (Recurso no existe - Devuelve 404 Not Found)
GET {{baseUrl}}/999
Content-Type: application/json


###############################################################################
# REQ-04 · Crear libros (POST /api/books)
###############################################################################

### 4.1 POST /api/books (Caso Exitoso - Crea un nuevo libro y devuelve 201 Created)
POST {{baseUrl}}
Content-Type: application/json

{
  "title": "The way of kings",
  "author": "Brandon Sanderson",
  "year": 2010
}

### 4.2 POST /api/books (Caso Exitoso - Crea otro libro y devuelve 201 Created)
POST {{baseUrl}}
Content-Type: application/json

{
  "title": "Dune",
  "author": "Frank Herbert",
  "year": 1965
}


###############################################################################
# REQ-05 · Validación de datos (POST /api/books)
###############################################################################

### 5.1 POST /api/books (Datos inválidos - Sin título -> 400 Bad Request)
POST {{baseUrl}}
Content-Type: application/json

{
  "author": "Robert C. Martin",
  "year": 2008
}

### 5.2 POST /api/books (Datos inválidos - Título solo con espacios -> 400 Bad Request)
POST {{baseUrl}}
Content-Type: application/json

{
  "title": "   ",
  "author": "Robert C. Martin",
  "year": 2008
}

### 5.3 POST /api/books (Datos inválidos - Sin autor -> 400 Bad Request)
POST {{baseUrl}}
Content-Type: application/json

{
  "title": "The Pragmatic Programmer",
  "year": 1999
}

### 5.4 POST /api/books (Datos inválidos - Año no numérico -> 400 Bad Request)
POST {{baseUrl}}
Content-Type: application/json

{
  "title": "The Pragmatic Programmer",
  "author": "Andrew Hunt",
  "year": "mil novecentos noventa y nueve"
}


###############################################################################
# REQ-06 · Eliminar libros (DELETE /api/books/:id)
###############################################################################

### 6.1 DELETE /api/books/2 (Caso Exitoso - Elimina "Design Patterns" -> 204 No Content o 200)
DELETE {{baseUrl}}/2
Content-Type: application/json

### 6.2 DELETE /api/books/2 (Recurso no existe / Ya eliminado -> 404 Not Found)
DELETE {{baseUrl}}/2
Content-Type: application/json


###############################################################################
# REQ-07 · Actualización parcial (PATCH /api/books/:id)
###############################################################################

### 7.1 PATCH /api/books/1 (Caso Exitoso - Modifica solo el año de "Clean Code")
PATCH {{baseUrl}}/1
Content-Type: application/json

{
  "year": 2018
}

### 7.2 PATCH /api/books/999 (Recurso no existe -> 404 Not Found)
PATCH {{baseUrl}}/999
Content-Type: application/json

{
  "title": "Libro Inexistente"
}

###############################################################################
# REQ-08 · Búsqueda mediante query parameters (GET /api/books?author=...)
###############################################################################

### 8.1 GET /api/books?author=Robert (Caso Exitoso - Filtra y encuentra a Robert C. Martin)
GET {{baseUrl}}?author=Robert
Content-Type: application/json

### 8.2 GET /api/books?author=Desconocido (Filtro sin coincidencias -> Devuelve array vacío [])
GET {{baseUrl}}?author=Desconocido
Content-Type: application/json


